---
import Layout from './Layout.astro';
import { withBase } from '../utils/paths';
interface Props {
  title: string;
  year: number;
  kind: 'Film' | 'TV series';
  credits: string[];
  description: string;
}
const { title, year, kind, credits, description } = Astro.props;
---
<Layout title={`${title} (${year}) — Cinestripes`} description={description}>
  <main id="main" class="wrap detail-page">
    <a class="back-link" href={withBase('#collection')}><span aria-hidden="true">←</span> Back to collection</a>
    <header class="detail-header">
      <p class="eyebrow">{kind} <span aria-hidden="true">/</span> {year}</p>
      <h1>{title}</h1>
      <p class="credits"><span>{kind === 'Film' ? 'Directed by' : 'Created by'}</span> {credits.join(' & ')}</p>
    </header>
    <slot />
  </main>
</Layout>
<style>
  .detail-page { padding-block: 35px 70px; }
  .back-link { font-size: 12px; text-decoration: none; }
  .back-link span { margin-right: 10px; }
  .detail-header { padding: 50px 0 38px; }
  .eyebrow { margin: 0 0 18px; color: var(--accent); font: 11px var(--mono); letter-spacing: 1.3px; text-transform: uppercase; }
  .eyebrow span { padding-inline: 9px; color: var(--line-strong); }
  h1 { max-width: 1050px; margin: 0; font-size: clamp(36px, 5.5vw, 72px); font-weight: 500; line-height: 1.08; letter-spacing: -.055em; overflow-wrap: anywhere; }
  .credits { margin: 22px 0 0; font-size: 14px; line-height: 1.6; }
  .credits span { margin-right: 8px; color: var(--muted); }
  @media (max-width: 600px) {
    .detail-page { padding-block: 25px 45px; }
    .detail-header { padding: 35px 0 28px; }
    .credits { font-size: 12px; }
  }
</style>
