---
import StripeImage from './StripeImage.astro';
import type { CollectionEntry } from '../data/collection';

interface Props { entry: CollectionEntry; index: number; }
const { entry, index } = Astro.props;
---

<article aria-labelledby={`${entry.slug}-title`}>
  <a class="image-link" href={entry.href} aria-label={`View ${entry.title} details`}>
    <StripeImage image={entry.image} imageDescription={entry.imageDescription} eager={index === 0} />
    <span class="image-hint" aria-hidden="true">{entry.kind === 'movie' ? 'View film' : 'Explore series'} →</span>
  </a>
  <div class="movie-details">
    <span class="movie-number" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
    <div class="title-block"><p class="entry-kind">{entry.kind === 'movie' ? 'Film' : `TV series · ${entry.episodes.length} episode${entry.episodes.length === 1 ? '' : 's'} in collection`}</p><div class="movie-heading">
      <h3 id={`${entry.slug}-title`}><a href={entry.href}>{entry.title}</a></h3>
      <span class="year">{entry.year}</span>
    </div>
    </div>
    <div class="directors"><span class="detail-label">{entry.kind === 'movie' ? 'Directed by' : 'Created by'}</span><p>{(entry.kind === 'movie' ? entry.directors : entry.creators).join(' & ')}</p></div>
    <a class="view-link" href={entry.href} aria-label={`View ${entry.title} details`}>{entry.kind === 'movie' ? 'View film' : 'View series'} <span aria-hidden="true">→</span></a>
  </div>
</article>

<style>
  .image-link { position: relative; display: block; overflow: hidden; background: #252621; }
  .entry-kind { margin: 0 0 8px; color: var(--muted); font: 9px var(--mono); text-transform: uppercase; letter-spacing: .6px; }
  h3 a { text-decoration: none; }
  .image-hint { position: absolute; bottom: 20px; right: 20px; background: var(--paper); color: var(--ink); padding: 10px 13px; font: 11px var(--mono); opacity: 0; transform: translateY(4px); transition: opacity .2s, transform .2s; }
  .image-link:hover .image-hint, .image-link:focus-visible .image-hint { opacity: 1; transform: none; }
  .movie-details { display: grid; grid-template-columns: 34px minmax(0, 1fr) minmax(0, 1fr) auto; gap: 15px; align-items: center; padding: 22px 0 0; }
  .movie-number { align-self: start; padding-top: 8px; color: var(--muted); font: 10px var(--mono); }
  .movie-heading { display: flex; align-items: baseline; flex-wrap: wrap; gap: 6px 13px; }
  h3 { margin: 0; font-size: 25px; overflow-wrap: anywhere; font-weight: 500; letter-spacing: -.7px; }
  .year { font: 12px var(--mono); color: var(--muted); }
  .detail-label { color: var(--muted); font: 9px var(--mono); letter-spacing: 1px; text-transform: uppercase; }
  .directors p { margin: 5px 0 0; font-size: 13px; }
  .view-link { font-size: 11px; text-decoration: none; padding: 10px 0 10px 12px; }
  .view-link span { font-size: 17px; margin-left: 17px; }
  @media (max-width: 600px) {
    .movie-details { grid-template-columns: 21px 1fr auto; gap: 10px; padding-top: 17px; }
    h3 { font-size: 22px; }
    .movie-heading { gap: 10px; }
    .year { font-size: 10px; }
    .directors { grid-column: 2 / -1; grid-row: 2; }
    .directors p { display: inline; margin-left: 5px; font-size: 11px; }
    .detail-label { font-size: 8px; letter-spacing: .5px; }
    .view-link { grid-column: 3; grid-row: 1; font-size: 10px; padding: 3px 0; }
    .view-link span { margin-left: 6px; }
    .image-hint { display: none; }
  }
  @media (prefers-reduced-motion: reduce) { .image-hint { transition: none; transform: none; } }
</style>
